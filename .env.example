# Backend (see DEPLOYMENT.md for the Cloud Run values)
DEEPFAKE_SHIELD_MAX_UPLOAD_BYTES=32000000
DEEPFAKE_SHIELD_UPLOAD_ROOT=/tmp/deepfake-shield-uploads
# Finish the analysis inside POST /api/v1/analyze (needed on Cloud Run).
SYNC_ANALYSIS=false
# Comma-separated; defaults to the local Vite ports.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Accepted analyses per client IP per hour; 0 disables.
RATE_LIMIT_PER_HOUR=0
TRUST_X_FORWARDED_FOR=false
MAX_CONCURRENT_ANALYSES=1
RETENTION_SECONDS=3600
MAX_RECORDS=200
# With PROTECT_LIST=true, GET /api/v1/analyze needs "Authorization: Bearer $ADMIN_TOKEN".
PROTECT_LIST=false
ADMIN_TOKEN=

# Dataset roots: point these to licensed media directories, not repository code.
FACEFORENSICS_ROOT=datasets/raw/faceforensics
CELEBDF_ROOT=datasets/raw/celebdf

# Future persistence
DATABASE_URL=postgresql://user:password@localhost:5432/deepfake_shield
